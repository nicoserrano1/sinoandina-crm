# ==============================================================================
# SINOANDINA REVENUE MACHINE (SaaS B2B) · VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo a .env.local para desarrollo local:
# cp .env.example .env.local
# Y agrégalas en Vercel -> Project Settings -> Environment Variables
# ==============================================================================

# 1. Inteligencia Artificial (Google Gemini 3.8 Flash)
GEMINI_API_KEY=tu_clave_gemini_aqui

# 2. Supabase (PostgreSQL Cloud & Autenticación)
# Obtenidos en supabase.com -> Tu Proyecto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Envío de Correos (Opcional - Resend 3.000 correos/mes gratis)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
